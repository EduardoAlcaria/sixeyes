
SPRING_PROFILES_ACTIVE=dev

DB_NAME=sixeyesdb
DB_USERNAME=sixeyes
DB_PASSWORD=changeme

JWT_SECRET=CHANGE_ME_base64_secret_at_least_32_chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

DOWNLOAD_PATH=./downloads

# Host drives mounted into the Python agent for browsing/saving outside DOWNLOAD_PATH.
# Defaults assume Docker Desktop on Windows (C:\, D:\ shared drives).
# On Linux/macOS, point these at real host paths instead, e.g.:
#   HOST_MOUNT_C=/home/you/Downloads
#   HOST_MOUNT_D=/mnt/storage
HOST_MOUNT_C=C:/
HOST_MOUNT_D=D:/

DOMAIN=sixeyes.alcaria.dev

TUNNEL_TOKEN=your-cloudflare-tunnel-token

IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret
