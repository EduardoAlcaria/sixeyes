# --- Native run (scripts/start.ps1) -----------------------------------------
# "local" = H2 file database, Secure cookies off for plain http://localhost.
SPRING_PROFILES_ACTIVE=local

ADMIN_USERNAME=admin
# Use a long random value from a password manager. Behind Cloudflare Access this is the
# second gate, not the first - but it is the one that guards your filesystem.
ADMIN_PASSWORD=changeme

DOWNLOAD_PATH=./downloads

# Where the agent is allowed to WRITE (comma-separated). Browsing spans every drive
# read-only regardless; this list is what save paths and mkdir are confined to.
# ALLOWED_WRITE_ROOTS=D:\Games,D:\Downloads

# Auto-install target. Leave blank to queue install requests without executing anything.
# INSTALL_ROOT=D:\Games

# Uncomment to also listen on the LAN instead of loopback only. Loopback means the only
# way in is the Cloudflare tunnel, which is the safer default.
# SERVER_ADDRESS=0.0.0.0

# Turn on only if SERVER_ADDRESS is widened - rejects requests that did not pass through
# Cloudflare Access.
# CF_ACCESS_REQUIRE_ASSERTION=true

# Session lifetimes. expires_at slides on activity; the absolute cap never moves.
# SESSION_IDLE_MINUTES=1440
# SESSION_ABSOLUTE_DAYS=30

IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# --- Cloudflare tunnel -------------------------------------------------------
# cloudflared runs as a Windows service (see docs/runbook-native.md), not a container.
DOMAIN=sixeyes.alcaria.dev
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# --- Docker deploy only (docker-compose.yml) ---------------------------------
# Not used by the native run; kept for deploying to a real server.
DB_NAME=sixeyesdb
DB_USERNAME=sixeyes
DB_PASSWORD=changeme
